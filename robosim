ACCENT = "\033[38;2;16;185;129m"
MUTED = "\033[38;2;130;140;158m"
TEXT = "\033[38;2;240;244;248m"
DIM = "\033[38;2;82;88;102m"
WARN = "\033[38;2;245;158;11m"
ERR = "\033[38;2;239;68;68m"
BOLD = "\033[1m"
RESET = "\033[0m"
CLEAR_LINE = "\033[2K"
_ANSI = re.compile(r"\033\[[0-9;]*m")
BANNER_INNER = 48


def _c(code: str, value: str) -> str:
    if not sys.stdout.isatty():
        return value
    return f"{code}{value}{RESET}"


def _write(line: str = "") -> None:
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def _tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def _visible_len(text: str) -> int:
    return len(_ANSI.sub("", text))


def _banner_row(content: str) -> str:
    pad = BANNER_INNER - _visible_len(content)
    return _c(ACCENT, "  │") + content + (" " * max(pad, 0)) + _c(ACCENT, "│")


def banner() -> None:
    _write()
    _write(_c(ACCENT, "  ╭" + "─" * BANNER_INNER + "╮"))
    _write(_banner_row(""))
    _write(_banner_row("   " + _c(BOLD + TEXT, "ROBOSIM AT HOME")))
    _write(_banner_row("   " + _c(MUTED, "MuJoCo studio for a cheap robot arm")))
    _write(_banner_row(""))
    _write(_c(ACCENT, "  ╰" + "─" * BANNER_INNER + "╯"))
    _write()


def phase(title: str) -> None:
    _write()
    _write(_c(DIM, "  ── ") + _c(BOLD + TEXT, title) + _c(DIM, " ──"))


def info(text: str) -> None:
    _write(_c(MUTED, "  ") + _c(TEXT, text))


def ok(text: str) -> None:
    _write(_c(ACCENT, "  ▸ ") + _c(TEXT, text))


def warn(text: str) -> None:
    _write(_c(WARN, "  ! ") + _c(TEXT, text))


def fail(text: str) -> None:
    _write(_c(ERR, "  ✕ ") + _c(TEXT, text))
    raise SystemExit(1)


def _read_key() -> str:
    if not _tty():
        return (sys.stdin.readline() or "").strip()
    import termios
    import tty

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    if ch in ("\x03", "\x04"):
        raise KeyboardInterrupt
    return ch


def choose_pack() -> str:
    _write(_c(TEXT, "  Welcome. Download an asset pack, the demo policy, and the demo dataset, then open the studio."))
    _write()
    _write(_c(ACCENT, "  1  ") + _c(BOLD + TEXT, PACKS["demo"]["title"]) + _c(MUTED, f"   {PACKS['demo']['size']}"))
    _write(_c(DIM, f"     {PACKS['demo']['detail']}"))
    _write()
    _write(_c(ACCENT, "  2  ") + _c(BOLD + TEXT, PACKS["full"]["title"]) + _c(MUTED, f"   {PACKS['full']['size']}"))
    _write(_c(DIM, f"     {PACKS['full']['detail']}"))
    _write()
    _write(_c(DIM, "  Both packs also fetch the demo ACT and SmolVLA checkpoints and the blue-krill dataset."))
    _write()
    _write(_c(DIM, "  q  Quit"))
    _write()
    sys.stdout.write(_c(ACCENT, "  → "))
    sys.stdout.flush()
    while True:
        key = _read_key().lower()
        if key in ("1", "d"):
            _write(_c(TEXT, "1"))
            return "demo"
        if key in ("2", "f"):
            _write(_c(TEXT, "2"))
            return "full"
        if key in ("q", "\x1b"):
            _write(_c(TEXT, "q"))
            raise SystemExit(0)


def ask_yes(prompt: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    sys.stdout.write(_c(TEXT, f"  {prompt} ") + _c(MUTED, f"[{hint}] "))
    sys.stdout.flush()
    key = _read_key().lower()
    if key in ("", "\r", "\n"):
        _write()
        return default
    _write(key)
    if key == "y":
        return True
    if key == "n":
        return False
    return default


def _object_count() -> int:
    root = ASSETS_DIR / "objects" / "models"
    if not root.is_dir():
        return 0
    return sum(1 for path in root.iterdir() if path.is_dir())


def _yaml_pack() -> str | None:
    path = ASSETS_DIR / "assets.yaml"
    if not path.is_file():
        return None
    for line in path.read_text().splitlines():
        if line.startswith("pack:"):
            value = line.split(":", 1)[1].strip().strip("\"'")
            if value in PACKS:
                return value
    return None


def assets_ready() -> bool:
    return (ASSETS_DIR / "robot" / "so_arm100.xml").is_file() and _object_count() > 0


def current_pack() -> str | None:
    if not assets_ready():
        return None
    marked = _yaml_pack()
    if marked:
        return marked
    return "full" if _object_count() >= FULL_OBJECT_MIN else "demo"


def _format_bytes(value: float) -> str:
    units = ("B", "KB", "MB", "GB")
    size = float(value)
    for unit in units:
        if size < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{int(size)} {unit}"
            return f"{size:.1f} {unit}"
        size /= 1024
    return f"{value:.0f} B"


def _bar(ratio: float, width: int = 28) -> str:
    filled = max(0, min(width, int(round(width * ratio))))
    return "█" * filled + "░" * (width - filled)


def _draw_progress(label: str, current: int, total: int | None) -> None:
    if total:
        ratio = min(1.0, current / total)
        line = (
            f"  {_c(ACCENT, '▸')} {_c(TEXT, label):<22} "
            f"{_c(ACCENT, _bar(ratio))} "
            f"{_c(MUTED, f'{_format_bytes(current)} / {_format_bytes(total)}')}"
        )
    else:
        line = f"  {_c(ACCENT, '▸')} {_c(TEXT, label)}  {_c(MUTED, _format_bytes(current))}"
    sys.stdout.write("\r" + CLEAR_LINE + line)
    sys.stdout.flush()


def _pack_url(kind: str) -> str:
    item = PACKS[kind]
    return (
        f"https://huggingface.co/datasets/{item['repo']}/resolve/main/{item['name']}"
        "?download=true"
    )


def download_pack(kind: str) -> Path:
    item = PACKS[kind]
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = CACHE_DIR / item["name"]
    request = urllib.request.Request(_pack_url(kind), headers={"User-Agent": USER_AGENT})
    try:
        handle = urllib.request.urlopen(request, timeout=60)
    except urllib.error.URLError as error:
        fail(f"Cannot reach Hugging Face: {error}")
    with handle:
        total = handle.headers.get("Content-Length")
        total_n = int(total) if total and total.isdigit() else None
        if dest.is_file() and total_n and dest.stat().st_size == total_n:
            ok(f"{item['name']} already cached")
            return dest
        tmp = dest.with_suffix(dest.suffix + ".part")
        done = 0
        with tmp.open("wb") as out:
            while True:
                chunk = handle.read(CHUNK)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                _draw_progress(f"Download {item['title']}", done, total_n)
        tmp.replace(dest)
    sys.stdout.write("\n")
    ok(f"Downloaded {item['name']}")
    return dest


def _safe_members(archive: tarfile.TarFile, dest: Path):
    root = dest.resolve()
    for member in archive.getmembers():
        target = (root / member.name).resolve()
        if target != root and root not in target.parents:
            raise RuntimeError(f"unsafe path in archive: {member.name}")
        yield member


def unpack_pack(kind: str, archive_path: Path) -> None:
    ASSETS_DIR.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive_path, "r:gz") as archive:
        members = list(_safe_members(archive, ASSETS_DIR))
        total = len(members)
        for index, member in enumerate(members, start=1):
            extra = {}
            if hasattr(tarfile, "data_filter"):
                extra["filter"] = "data"
            archive.extract(member, path=ASSETS_DIR, **extra)
            if index == total or index % 80 == 0:
                _draw_progress(f"Unpack {PACKS[kind]['title']}", index, total)
    sys.stdout.write("\n")
    if not assets_ready():
        fail("Archive unpacked, but robot or objects are missing")
    ok(f"Assets ready · {_object_count()} objects")


def install_pack(kind: str) -> None:
    phase(f"Assets · {PACKS[kind]['title']}")
    archive = download_pack(kind)
    unpack_pack(kind, archive)


def _hf_file_url(repo: str, name: str, repo_type: str) -> str:
    root = "datasets/" if repo_type == "dataset" else ""
    return f"https://huggingface.co/{root}{repo}/resolve/main/{name}?download=true"


def download_hf_file(url: str, dest: Path, label: str) -> Path:
    dest.parent.mkdir(parents=True, exist_ok=True)
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        handle = urllib.request.urlopen(request, timeout=60)
    except urllib.error.URLError as error:
        fail(f"Cannot reach Hugging Face: {error}")
    with handle:
        total = handle.headers.get("Content-Length")
        total_n = int(total) if total and total.isdigit() else None
        if dest.is_file() and total_n and dest.stat().st_size == total_n:
            ok(f"{dest.name} already cached")
            return dest
        tmp = dest.with_suffix(dest.suffix + ".part")
        done = 0
        with tmp.open("wb") as out:
            while True:
                chunk = handle.read(CHUNK)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                _draw_progress(f"Download {label}", done, total_n)
        tmp.replace(dest)
    sys.stdout.write("\n")
    ok(f"Downloaded {dest.name}")
    return dest


def _policy_ready(item: dict) -> bool:
    dest = item["dir"]
    return (dest / "model.safetensors").is_file() and (dest / "config.json").is_file()


def starter_model_ready() -> bool:
    return all(_policy_ready(item) for item in STARTER_POLICIES)


def starter_dataset_ready() -> bool:
    if not (STARTER_DATASET_DIR / "dataset.json").is_file():
        return False
    return any(
        path.is_dir() and path.name.startswith("episode_")
        for path in STARTER_DATASET_DIR.iterdir()
    )


def starter_ready() -> bool:
    return starter_model_ready() and starter_dataset_ready()


def install_starter_model() -> None:
    for item in STARTER_POLICIES:
        dest = item["dir"]
        if _policy_ready(item):
            ok(f"{item['title']} already on disk")
            continue
        phase(item["title"])
        dest.mkdir(parents=True, exist_ok=True)
        for name in item["files"]:
            download_hf_file(
                _hf_file_url(item["repo"], name, "model"),
                dest / name,
                name,
            )
        last = dest.parent.parent / "last"
        if last.exists() or last.is_symlink():
            last.unlink()
        last.symlink_to(dest.parent.name)
        if not _policy_ready(item):
            fail(f"{item['title']} downloaded, but files are missing")
        ok(f"{item['title']} ready")


def install_starter_dataset() -> None:
    if starter_dataset_ready():
        ok("Demo dataset already on disk")
        return
    phase("Demo dataset")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    archive = download_hf_file(
        _hf_file_url(STARTER_DATASET["repo"], STARTER_DATASET["name"], "dataset"),
        CACHE_DIR / STARTER_DATASET["name"],
        STARTER_DATASET["title"],
    )
    STARTER_DATASET_DIR.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive, "r:gz") as packed:
        members = list(_safe_members(packed, STARTER_DATASET_DIR))
        total = len(members)
        for index, member in enumerate(members, start=1):
            extra = {}
            if hasattr(tarfile, "data_filter"):
                extra["filter"] = "data"
            packed.extract(member, path=STARTER_DATASET_DIR, **extra)
            if index == total or index % 80 == 0:
                _draw_progress(f"Unpack {STARTER_DATASET['title']}", index, total)
    sys.stdout.write("\n")
    if not starter_dataset_ready():
        fail("Demo dataset unpacked, but episodes are missing")
    ok("Demo dataset ready")


def install_starter() -> None:
    install_starter_model()
    install_starter_dataset()


def _which_compose() -> list[str]:
    if shutil.which("docker"):
        probe = subprocess.run(
            ["docker", "compose", "version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if probe.returncode == 0:
            return ["docker", "compose"]
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    fail("Docker Compose is not installed")
    return []


def image_exists() -> bool:
    if not shutil.which("docker"):
        return False
    probe = subprocess.run(
        ["docker", "image", "inspect", IMAGE_NAME],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return probe.returncode == 0


def _color_log(line: str) -> str:
    low = line.lower()
    if "error" in low or "traceback" in low or " errno" in low:
        return _c(ERR, line)
    if "warn" in low:
        return _c(WARN, line)
    if "http/1.1\" 2" in low or " 200 " in low:
        return _c(DIM, line)
    return _c(TEXT, line)


def _stream(cmd: list[str], cwd: Path) -> int:
    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None
    try:
        for raw in proc.stdout:
            line = raw.rstrip("\n")
            if not line.strip():
                continue
            stamp = time.strftime("%H:%M:%S")
            _write(_c(DIM, f"  {stamp}  ") + _color_log(line))
    except KeyboardInterrupt:
        proc.terminate()
        try:
            proc.wait(timeout=8)
        except subprocess.TimeoutExpired:
            proc.kill()
        raise
    return proc.wait()


def build_docker(compose: list[str]) -> None:
    phase("Docker build")
    info("This can take a while the first time.")
    code = _stream(compose + ["-f", str(COMPOSE_FILE), "build"], REPO_ROOT)
    if code != 0:
        fail("Docker build failed")
    ok("Image ready")


def _studio_ready(url: str) -> bool:
    request = urllib.request.Request(
        f"{url}/api/state",
        headers={"User-Agent": USER_AGENT},
    )
    try:
        with urllib.request.urlopen(request, timeout=4.0) as handle:
            if handle.status != 200:
                return False
            json.loads(handle.read().decode("utf-8"))
            return True
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return False


def run_studio(compose: list[str]) -> None:
    url = f"http://{STUDIO_HOST}:{STUDIO_PORT}"
    phase("Studio")
    info("Starting…")
    env = os.environ.copy()
    env["ROBOSIM_PORT"] = str(STUDIO_PORT)
    proc = subprocess.Popen(
        compose + ["-f", str(COMPOSE_FILE), "up", "--abort-on-container-exit"],
        cwd=REPO_ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env=env,
    )
    assert proc.stdout is not None
    opened = threading.Event()

    def announce() -> None:
        while proc.poll() is None and not opened.is_set():
            if _studio_ready(url):
                _write(_c(ACCENT, "  ● ") + _c(BOLD + TEXT, "Open  ") + _c(ACCENT, url))
                _write(_c(DIM, "    Logs below. Ctrl+C stops the studio."))
                _write()
                opened.set()
                return
            time.sleep(STUDIO_READY_POLL_S)

    threading.Thread(target=announce, daemon=True).start()
    try:
        for raw in proc.stdout:
            line = raw.rstrip("\n")
            if not line.strip():
                continue
            stamp = time.strftime("%H:%M:%S")
            _write(_c(DIM, f"  {stamp}  ") + _color_log(line))
    except KeyboardInterrupt:
        opened.set()
        _write()
        info("Stopping…")
        proc.send_signal(2)
        try:
            proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            proc.terminate()
            proc.wait(timeout=8)
        ok("Stopped")
        return
    opened.set()
    if proc.wait() != 0:
        fail("Studio exited with an error")


def ensure_command() -> None:
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    link = BIN_DIR / COMMAND_NAME
    target = Path(__file__).resolve()
    if link.is_symlink() and link.resolve() == target:
        return
    if link.exists() or link.is_symlink():
        link.unlink()
    link.symlink_to(target)


def main() -> None:
    if not COMPOSE_FILE.is_file():
        fail("docker-compose.yml is missing")
    ensure_command()
    banner()
    pack = current_pack()
    first = pack is None or not image_exists()
    if pack is None:
        pack = choose_pack()
        install_pack(pack)
    elif first:
        info(f"{PACKS[pack]['title']} assets are already on disk.")
    else:
        info("Welcome back.")
        info(f"{PACKS[pack]['title']} pack is installed.")
        if pack == "demo" and ask_yes("Download the full archive?", default=False):
            install_pack("full")
            pack = "full"
    if not starter_ready():
        install_starter()
    compose = _which_compose()
    if not image_exists():
        build_docker(compose)
    elif first:
        ok("Docker image already built")
    run_studio(compose)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        _write()
        info("Cancelled")
        raise SystemExit(130)
